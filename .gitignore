# ─── Monorepo root: Project-Websites-Google-Antigravity ─────────────────────
# This .gitignore covers ALL projects in every sub-folder.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# Next.js build output
.next/
/out/
/build/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.*
!.env.example

# vercel
.vercel

# typescript build info
*.tsbuildinfo
next-env.d.ts

# sqlite / prisma dev databases
*.db
*.db-journal
*.db-shm
*.db-wal

# diagnostic/temp scripts
test-pg.js
verify-db.mjs
